+    /// Every other C++ function's parameter list, for overload choice (upstream reads it from
+    /// the source at resolution); ` = delete` marks one no call that compiles reaches.
+    fn cpp_parameters(&self, node: Node<'t>) -> Option<String> {
+        if self.variant != Variant::Cpp || self.recover_cpp_macro_defined_name(node).is_some() {
+            return None;
+        }
+        let mut d = node.child_by_field_name("declarator");
+        while let Some(x) = d {
+            if x.kind() == "function_declarator" {
+                let params = x.child_by_field_name("parameters")?;
+                let deleted = self.text(node).trim_end().trim_end_matches(';').trim_end().ends_with("delete");
+                return Some(format!("{}{}", self.text(params), if deleted { " = delete" } else { "" }));
+            }
+            d = inner_declarator(x);
+        }
+        None
     }
 
